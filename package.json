{
  "name": "chat-client",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "dev": "bun --bun vite",
    "build": "tsc --noEmit && bun --bun vite build",
    "preview": "bun --bun vite preview",
    "typecheck": "tsc --noEmit",
    "check:imports": "bun scripts/check-imports.ts",
    "check:css": "bun scripts/check-css.ts",
    "test": "bun test",
    "test:e2e": "bun --bun playwright test --project=chromium --grep-invert @screens",
    "test:e2e:all": "bun --bun playwright test --grep-invert @screens",
    "test:smoke": "bun --bun playwright test --project=chromium --grep @smoke",
    "test:screens": "bun --bun playwright test --project=chromium --grep @screens",
    "test:e2e:build": "bun run build && E2E_SERVER=preview bun --bun playwright test --project=chromium --grep @smoke",
    "test:report": "bun --bun playwright show-report",
    "data:seed": "bun scripts/seed.ts",
    "data:reset": "bun scripts/reset.ts",
    "data:check": "bun scripts/check-data.ts",
    "clean": "bun scripts/clean.ts",
    "check": "bun run typecheck && bun run check:imports && bun run check:css && bun run test"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
